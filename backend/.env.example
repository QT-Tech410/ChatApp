# Cổng backend
PORT=5001

# Chuỗi kết nối MongoDB
MONGODB_CONNECTIONSTRING=mongodb://localhost:27017/chatapp

# Secret ký JWT access token — dùng chuỗi ngẫu nhiên dài, KHÔNG commit giá trị thật
# ví dụ: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=

# Origin của frontend (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Cloudinary (upload ảnh)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (Tuỳ chọn: Pub/Sub Socket Cluster & Caching tầng nóng. Tự động fallback In-Memory nếu không có)
REDIS_URL=redis://127.0.0.1:6379
